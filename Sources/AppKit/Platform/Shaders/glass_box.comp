#version 450
#extension GL_GOOGLE_include_directive : require
// One box pass, exactly the software running sum: 2r + 1 border-clamped bytes per channel,
// divided with truncation (see glass.metal).
#include "glass_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pass.width || gid.y >= pass.height) return;
    int r = int(pass.radius);
    int last = int(pass.horizontal != 0u ? pass.width : pass.height) - 1;
    int at = int(pass.horizontal != 0u ? gid.x : gid.y);
    uvec4 sum = uvec4(0u);
    for (int i = -r; i <= r; i++) {
        uint j = uint(clamp(at + i, 0, last));
        uint idx = pass.horizontal != 0u ? gid.y * pass.stride + j : j * pass.stride + gid.x;
        sum += glass_unpack(src[idx]);
    }
    dst[gid.y * pass.stride + gid.x] = glass_pack(sum / uint(2 * r + 1));
}
