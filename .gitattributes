# Upstream sample documents stay LF on every checkout (core.autocrlf=true turned them into
# CR LF on the Windows PC, where the app counts lines by "\n").
Examples/MDVault/Resources/*.md text eol=lf
# BundleTests' fixture app folder (ADR-0045): checked out byte for byte (NSDataAsset hands back
# a file's bytes unchanged, and the strings files' contents are compared).
Tests/AppKitTests/Fixtures/** -text
# The Liquid Glass shader sources (ADR-0052 stage 2) are embedded and hashed byte for byte;
# a CR LF checkout would change their text and hashes.
Sources/AppKit/Platform/Shaders/** text eol=lf
