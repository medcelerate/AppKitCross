    "NSTouchBarDelegate": "Touch Bar: makes items for a Touch Bar; no Touch Bar hardware off macOS",
    "NSTouchBarProvider": "Touch Bar: supplies a responder's Touch Bar; no Touch Bar hardware off macOS",
    "NSButtonTouchBarItem": "Touch Bar: button item; no Touch Bar hardware off macOS",
    "NSCandidateListTouchBarItem": "Touch Bar: text-input candidate strip shown in the Touch Bar; no Touch Bar hardware off macOS (in-window candidates go through NSTextInputContext)",
    "NSCandidateListTouchBarItemDelegate": "Touch Bar: delegate of the Touch Bar candidate strip; no Touch Bar hardware off macOS",
    "NSColorPickerTouchBarItem": "Touch Bar: colour picker item; no Touch Bar hardware off macOS",
    "NSCustomTouchBarItem": "Touch Bar: item hosting a view in the Touch Bar; no Touch Bar hardware off macOS",
    "NSGroupTouchBarItem": "Touch Bar: group item; no Touch Bar hardware off macOS",
    "NSPickerTouchBarItem": "Touch Bar: picker item; no Touch Bar hardware off macOS",
    "NSPopoverTouchBarItem": "Touch Bar: popover item; no Touch Bar hardware off macOS",
    "NSSharingServicePickerTouchBarItem": "Touch Bar: sharing-service picker item; no Touch Bar hardware off macOS",
    "NSSharingServicePickerTouchBarItemDelegate": "Touch Bar: delegate of the sharing-service picker item; no Touch Bar hardware off macOS",
    "NSSliderTouchBarItem": "Touch Bar: slider item; no Touch Bar hardware off macOS",
    "NSStepperTouchBarItem": "Touch Bar: stepper item; no Touch Bar hardware off macOS",
    "NSWritingToolsCoordinator": "Writing Tools: drives Apple Intelligence's Writing Tools service (on-device and Private Cloud Compute models), which has no counterpart off macOS",
    "NSSpeechSynthesizer": "Speech: front end of the macOS speech engine (deprecated since macOS 14); voices, phonemes and speech dictionaries are that engine's own identifiers and formats",
    "NSSpeechSynthesizerDelegate": "Speech: delegate of the macOS speech engine's synthesizer (deprecated since macOS 14)",
    "NSSpeechRecognizer": "Speech: front end of macOS Speakable Items command recognition (deprecated since macOS 14), a macOS system service",
    "NSSpeechRecognizerDelegate": "Speech: delegate of macOS Speakable Items command recognition (deprecated since macOS 14)",
    "NSSharingService": "Sharing: each service is a macOS Sharing extension (AirDrop, Mail, Messages, Notes, iCloud collaboration) found through Launch Services",
    "NSSharingServiceDelegate": "Sharing: delegate of a macOS Sharing extension",
    "NSSharingServicePicker": "Sharing: menu of the macOS Sharing extensions that accept the items",
    "NSSharingServicePickerDelegate": "Sharing: delegate of the macOS sharing-service menu; hands out NSSharingService objects",
    "NSSharingServicePickerToolbarItem": "Sharing: toolbar item that opens the macOS sharing-service menu",
    "NSSharingServicePickerToolbarItemDelegate": "Sharing: supplies items to the macOS sharing-service toolbar item",
    "NSCloudSharingServiceDelegate": "Sharing: iCloud (CloudKit) collaboration through the cloud-sharing service",
    "NSCloudSharingValidation": "Sharing: validates menu items for iCloud (CloudKit) shares",
    "NSOpenGLView": "OpenGL: deprecated since macOS 10.14; wraps CGL contexts and pixel formats, and the port's GPU path is Metal (MTKView over D3D12 and Vulkan)",
    "NSOpenGLContext": "OpenGL: a CGL context (deprecated since macOS 10.14); the port's GPU path is Metal",
