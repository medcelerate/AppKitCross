# sway configuration for the headless Wayland run (tools/linux/run-wayland.sh).
output HEADLESS-1 resolution 1280x800 position 0,0 background #3c6e91 solid_color
font pango:DejaVu Sans 10
default_border normal 2
titlebar_padding 6 3
# Keep AppKitWin windows at the size they ask for instead of tiling them.
for_window [app_id="AppKitWin"] floating enable
focus_follows_mouse no
